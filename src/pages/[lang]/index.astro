---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Contact from '../../components/Contact.astro';
import Icon from '../../components/Icon.astro';
import portrait from '../../assets/portrait.png';
import artwork from '../../assets/legal-assistance.png';
import { copy, site, navIds, type Language } from '../../data/site';
export function getStaticPaths(){return [{params:{lang:'ne'}},{params:{lang:'en'}}];}
const lang = Astro.params.lang as Language;
const t=copy[lang];
const icons=['chat','scales','shield','document','contract','justice'];
const number=(n:number)=>lang==='ne'?String(n).padStart(2,'0').replace(/\d/g,d=>'०१२३४५६७८९'[+d]):String(n).padStart(2,'0');
---
<Base lang={lang}>
 <Header lang={lang}/>
 <main id="main">
  <section class="hero" id="home">
   <div class="container hero-grid">
    <div class="hero-copy"><p class="eyebrow"><span class="eyebrow-line"></span>{t.eyebrow}</p><p class="hero-name">{t.advocate} <strong>{t.name}</strong></p><h1 class="multiline">{t.heroTitle}</h1><p class="hero-lead">{t.heroLead}</p><p class="hero-description">{t.heroText}</p><div class="hero-buttons"><a class="button button-gold" href="#contact">{t.contact}<Icon/></a><a class="button button-outline" href={`tel:${site.telephone}`}><Icon name="phone" size={18}/>{t.call}</a></div><a class="text-link hero-explore" href="#services">{t.explore}<Icon size={17}/></a><div class="hero-location"><Icon name="pin" size={16}/>{t.location}<span aria-hidden="true">·</span><a href={`tel:${site.telephone}`}>{lang==='ne'?'९८५११५९८०७':site.phone}</a></div></div>
    <div class="hero-visual"><div class="portrait-rule" aria-hidden="true"></div><div class="portrait-frame"><Image src={portrait} alt={t.portraitAlt} widths={[400,640,900]} sizes="(max-width: 760px) 88vw, 40vw" width={640} height={823} format="webp" quality={85} loading="eager" fetchpriority="high"/></div><div class="portrait-caption"><span><small>{t.advocate}</small><strong>{t.name}</strong></span><Icon name="scales" size={32}/></div><span class="portrait-side" aria-hidden="true">DINESH DUWADI · ADVOCATE</span></div>
   </div>
  </section>
  <section class="statement"><div class="container statement-inner"><span class="statement-icon"><Icon name="scales" size={35}/></span><p class="multiline">{t.quote}</p><span class="statement-label">{t.quoteLabel}</span></div></section>
  <section class="section-pad" id="about"><div class="container about-grid"><div class="about-visual"><Image src={portrait} alt={t.portraitAlt} width={380} height={489} format="webp" loading="lazy"/><div class="about-caption"><span>{t.advocate}</span><strong>{t.name}</strong><small>{t.location}</small></div></div><div class="about-copy"><p class="eyebrow">{t.aboutLabel}</p><h2 class="multiline">{t.aboutTitle}</h2><p>{t.aboutText}</p><p>{t.aboutText2}</p><a href="#contact" class="text-link">{t.aboutLink}<Icon size={18}/></a></div></div></section>
  <section class="services section-pad" id="services"><div class="container"><div class="section-heading"><div><p class="eyebrow">{t.servicesLabel}</p><h2 class="multiline">{t.servicesTitle}</h2></div><p>{t.servicesIntro}</p></div><div class="service-grid">{t.services.map(([title,description],i)=><article class="service-card"><div class="card-top"><Icon name={icons[i]} size={29}/><span>{number(i+1)}</span></div><h3>{title}</h3><p>{description}</p><a href="#contact" class="service-link" aria-label={`${t.serviceLink}: ${title}`}><Icon size={20}/></a></article>)}</div></div></section>
  <section class="practice section-pad" id="practice"><div class="container practice-grid"><div><p class="eyebrow">{t.practiceLabel}</p><h2 class="multiline">{t.practiceTitle}</h2><p class="practice-note">{t.availability}</p></div><ul class="practice-list">{t.areas.map((area,i)=><li><span>{number(i+1)}</span><a href="#contact">{area}<Icon size={18}/></a></li>)}</ul></div></section>
  <section class="principles section-pad"><div class="container"><p class="eyebrow">{t.principlesLabel}</p><h2 class="multiline">{t.principlesTitle}</h2><div class="principle-grid">{t.principles.map(([title,description],i)=><div><span class="principle-number">{number(i+1)}</span><h3>{title}</h3><p>{description}</p></div>)}</div></div></section>
  <section class="process section-pad"><div class="container"><p class="eyebrow">{t.processLabel}</p><h2>{t.processTitle}</h2><ol class="process-grid">{t.steps.map(([title,description],i)=><li><span class="step-number">{number(i+1)}</span><h3>{title}</h3><p>{description}</p></li>)}</ol><p class="process-note">{t.relationship}</p></div></section>
  <section class="resources section-pad" id="resources"><div class="container"><div class="section-heading"><div><p class="eyebrow">{t.resourcesLabel}</p><h2 class="multiline">{t.resourcesTitle}</h2></div><p>{t.resourcesText}</p></div><div class="resources-grid"><div class="resource-links">{t.resources.map(([title,desc,url])=><a class="resource-card" href={url} target="_blank" rel="noopener noreferrer"><small>{t.official}</small><h3>{title}<Icon name="external" size={19}/></h3><p>{desc}</p></a>)}</div><article class="media-card"><div><span class="eyebrow">{t.media}</span><p>{t.mediaText}</p><details><summary>{t.artwork}<span aria-hidden="true">＋</span></summary><Image src={artwork} alt={t.artworkAlt} width={680} height={1020} format="webp" loading="lazy"/></details></div><span class="media-mark" aria-hidden="true"><Icon name="scales" size={88}/></span></article></div></div></section>
  <section class="faq section-pad" id="faq"><div class="container faq-grid"><div><p class="eyebrow">{t.faqLabel}</p><h2>{t.faqTitle}</h2><p>{t.faqIntro}</p><a class="text-link" href="#contact">{t.consult}<Icon size={18}/></a></div><div class="faq-list">{t.faqs.map(([q,a],i)=><details name="faq"><summary><span class="faq-number">{number(i+1)}</span><h3>{q}</h3><span class="faq-plus" aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></div></section>
  <Contact lang={lang}/>
 </main>
 <footer><div class="container"><div class="footer-grid"><div><a class="brand footer-brand" href={`/${lang}/`}><span class="brand-mark"><Icon name="scales" size={28}/></span><span><strong>{t.name}</strong><small>{t.advocate} · {t.location}</small></span></a><p>{t.footerStatement}</p><a href={`tel:${site.telephone}`}>{site.phone}</a><br/><a href={`mailto:${site.email}`}>{site.email}</a></div><div><h3>{t.quickLinks}</h3>{[1,4,5,6].map(i=><a class="footer-link" href={`#${navIds[i]}`}>{t.nav[i]}</a>)}</div><div><h3>{t.footerServices}</h3>{t.services.slice(0,4).map(([s])=><a class="footer-link" href="#services">{s}</a>)}</div></div><div class="footer-legal"><p>{t.disclaimer}<br/>{t.relationship}</p></div><div class="footer-bottom"><span>© <span data-year>{new Date().getFullYear()}</span> {t.advocate} {t.name}. {t.copyright}</span><a href="#home">{t.back}<span aria-hidden="true"> ↑</span></a></div></div></footer>
 <nav class="mobile-contact" aria-label={t.nav[6]}><a href={`tel:${site.telephone}`}><Icon name="phone" size={19}/>{t.call}</a><a href={`mailto:${site.email}`}><Icon name="mail" size={19}/>{t.email}</a><a href="#contact"><Icon name="chat" size={19}/>{t.mobileConsult}</a></nav>
 <script>document.querySelectorAll('[data-year]').forEach(el=>el.textContent=String(new Date().getFullYear()));</script>
</Base>
